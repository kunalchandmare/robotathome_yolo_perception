name: download
conda_env: conda.yaml

entry_points:
  main:
    parameters:

      out_dir:
        description: "Directory where files are downloaded"
        type: string

      extract_root:
        description: "Root directory where archives are extracted"
        type: string
        default: "."

      force_download:
        description: "Force re-download even if file already exists"
        type: string
        default: "False"

      dataset_url:
        description: "Dataset URL"
        type: string

      dataset_filename:
        description: "Downloaded filename"
        type: string

      dataset_md5:
        description: "Expected MD5 checksum"
        type: string

      dataset_extract_to:
        description: "Extraction path relative to extract_root for archives (required)"
        type: string

    command: >-
      python run.py --out_dir "{out_dir}" --extract_root "{extract_root}" --force_download "{force_download}" --dataset_url "{dataset_url}" --dataset_filename "{dataset_filename}" --dataset_md5 "{dataset_md5}" --dataset_extract_to "{dataset_extract_to}"
